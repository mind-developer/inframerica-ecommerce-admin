# Homologation admin config. Copy to .env.hml on the server (gitignored) and fill in. Never commit real values.
# The API is reached by name on the shared Docker network (see the API's compose.hml.yml).
API_URL=http://api:3333/api/v1

# Signs the admin session cookie. A long random string, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Storefront to notify after content edits (POST {STOREFRONT_URL}/api/revalidate), by its container name.
STOREFRONT_URL=http://storefront:3000
# Must match the storefront's REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Storefront address people open in the browser (admin links). Read at BUILD time: rebuild after changing it.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Session cookies over plain HTTP (nginx on port 80/8080, before TLS). Remove once hml has HTTPS.
COOKIE_SECURE=false
