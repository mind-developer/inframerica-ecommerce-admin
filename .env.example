# Copy to .env.local. Everything is optional in development.

# Signs the admin session cookie (mock auth). REQUIRED in production: a long random string.
SESSION_SECRET=

# Storefront to notify after content edits (POST {STOREFRONT_URL}/api/revalidate). Leave empty to skip.
STOREFRONT_URL=http://localhost:3000
# Must match the storefront's REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Artificial latency of the mock data layer, in ms, to see loading states in development.
MOCK_LATENCY_MS=0
